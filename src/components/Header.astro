---
import { SITE, CONTACT } from '../config';

const pad = Astro.url.pathname;
const isActive = (href: string) => pad === href || pad.startsWith(href);
const links = [
  { href: '/diensten/', label: 'Diensten' },
  { href: '/voorbeelden/', label: 'Voorbeelden' },
  { href: '/prijzen/', label: 'Prijzen' },
  { href: '/kennisbank/', label: 'Kennisbank' },
  { href: '/over/', label: 'Over ons' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — naar de homepage`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect width="32" height="32" rx="2" fill="#14342b"></rect>
        <path d="M10 8.5v15h3.4v-4.9l1.9-2 4.2 6.9h4L17.3 14l5.6-5.5h-4.3L13.4 14V8.5z" fill="#f3f4ef"></path>
        <circle cx="24.4" cy="7.6" r="2.1" fill="#f2c230"></circle>
      </svg>
      <span>
        <span class="brand__name">Kwartel Studio</span>
        <span class="brand__sub">Laren · Het Gooi</span>
      </span>
    </a>

    <nav class="nav" aria-label="Hoofdmenu">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary nav__cta" href="/contact/">
        Plan een gesprek<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </nav>

    <details class="menu">
      <summary>Menu</summary>
      <div class="menu__panel">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/contact/">Plan een gesprek</a>
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
      </div>
    </details>
  </div>
</header>
